{
  "name": "myvoice",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @myvoice/api --filter @myvoice/web --filter @myvoice/bot dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @myvoice/api test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @myvoice/api prisma:generate",
    "db:migrate": "pnpm --filter @myvoice/api prisma:migrate",
    "db:seed": "pnpm --filter @myvoice/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
